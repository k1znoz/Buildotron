{
  "name": "buildotron",
  "private": true,
  "workspaces": [
    "Apps/*",
    "packages/*",
    "plugins"
  ],
  "overrides": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "scripts": {
    "generate": "node --experimental-strip-types packages/generator/src/cli.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test --experimental-strip-types --test-isolation=none"
  },
  "devDependencies": {
    "prettier": "3.8.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "optionalDependencies": {
    "@rolldown/binding-linux-x64-gnu": "1.2.6",
    "lightningcss-linux-x64-gnu": "1.33.0"
  }
}
